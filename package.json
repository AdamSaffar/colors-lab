{
  "name": "colors-lab",
  "version": "1.0.0",
  "description": "COLORS is a simple web application built using the LAMP stack. The application allows users to log in, add colors to their account, and search for previously added colors.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "lint:html": "htmlhint index.html color.html",
    "lint:css": "stylelint css/styles.css",
    "lint:js": "eslint \"js/**/*.js\"",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdamSaffar/colors-lab.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/AdamSaffar/colors-lab/issues"
  },
  "homepage": "https://github.com/AdamSaffar/colors-lab#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "htmlhint": "^1.9.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
